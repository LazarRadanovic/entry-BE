# Copy to .env (docker compose reads it automatically). Never commit the real .env.
# Generate a secret with: openssl rand -base64 48
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Web Push (optional; push is disabled when empty). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Billing (optional). Without STRIPE_SECRET_KEY + STRIPE_PRICE_ID nothing is enforced and entrances are free.
# New entrances get a free trial, then an admin must subscribe via Stripe Checkout.
BILLING_TRIAL_DAYS=30
STRIPE_SECRET_KEY=            # sk_test_... from https://dashboard.stripe.com/test/apikeys
STRIPE_PRICE_ID=              # price_... of a recurring price (Products -> add product -> monthly price)
STRIPE_WEBHOOK_SECRET=        # whsec_... printed by: stripe listen --forward-to localhost:8080/api/billing/webhook
BILLING_PRICE_LABEL=€4.99 / month
APP_URL=http://localhost:4200
